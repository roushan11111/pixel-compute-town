# ==============================================================================
# PixelCompute Town (像素算力鎮) v1.2 — Environment Configuration
# Copy this file to `.env` for local production testing or set in Render / Fly.io
# ==============================================================================

# Server listen port (default: 3456)
PORT=3456

# Bind host (use 0.0.0.0 for Docker / Render / Fly.io; 127.0.0.1 for local-only)
HOST=0.0.0.0

# Public base URL of your deployed instance (no trailing slash)
# Example: https://pixel-compute-town.onrender.com or https://town.yourdomain.com
APP_BASE_URL=http://localhost:3456

# Optional custom directory for native SQLite WAL DB (pixelcompute.db) & state mirror (default: ./data)
# Useful when mounting a persistent disk/volume at /app/data in production
PIXEL_DATA_DIR=./data

# Optional write API rate limit per IP per minute (default: 120)
RATE_LIMIT_MAX=120

# Optional secret used to sign session cookies in production (recommended: 32+ random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------------------------
# OAuth Providers (Optional — Email/Password & Demo Mode work out-of-the-box!)
# ------------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers -> OAuth Apps
# Callback URL: ${APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# GitHub Webhook Auto-Settlement (v1.2 — PR Merge -> Core Points & Stake Refund)
# GitHub Repo Settings -> Webhooks -> Add webhook:
#   Payload URL: ${APP_BASE_URL}/api/webhooks/github
#   Content type: application/json
#   Events: Pull requests (triggers auto-settlement when merged with "Fixes #task-<id>")
#   Secret: set the same random hex string below for HMAC-SHA256 (X-Hub-Signature-256)
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Track 1 Payments: Stablecoin Treasury Addresses (USDC / USDT)
# Supported EVM chains: Base (recommended), Polygon, Arbitrum
# Supported Solana: SPL USDC / USDT
# Leave empty to use built-in Sandbox/Demo treasury addresses for testing
# ------------------------------------------------------------------------------
TREASURY_EVM_ADDRESS=
TREASURY_SOL_ADDRESS=
TREASURY_TRON_ADDRESS=

# ------------------------------------------------------------------------------
# Track 2 Payments: Fiat Checkout & Webhooks (Polar.sh / Stripe)
# Supports a single fallback URL or per-product checkout links
# Webhook URLs:
#   Polar:  ${APP_BASE_URL}/api/webhooks/polar
#   Stripe: ${APP_BASE_URL}/api/webhooks/stripe
# ------------------------------------------------------------------------------
POLAR_CHECKOUT_URL=
POLAR_PRO_CHECKOUT_URL=
POLAR_GENESIS_CHECKOUT_URL=
POLAR_BILLBOARD_CHECKOUT_URL=
POLAR_BOUNTY_CHECKOUT_URL=
POLAR_WEBHOOK_SECRET=

STRIPE_CHECKOUT_URL=
STRIPE_PRO_CHECKOUT_URL=
STRIPE_GENESIS_CHECKOUT_URL=
STRIPE_BILLBOARD_CHECKOUT_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Track 3 Payments: Afdian (愛發電 - WeChat/Alipay) & Redeem Code Storefront
# Webhook URL for Afdian Developer Center:
#   ${APP_BASE_URL}/api/webhooks/afdian
#   (or ${APP_BASE_URL}/api/webhooks/afdian?token=<AFDIAN_WEBHOOK_TOKEN>)
# ------------------------------------------------------------------------------
AFDIAN_STORE_URL=
AFDIAN_PRO_URL=
AFDIAN_GENESIS_URL=
AFDIAN_BILLBOARD_URL=
AFDIAN_WEBHOOK_TOKEN=
REDEEM_STORE_URL=
