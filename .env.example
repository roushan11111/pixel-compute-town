# ==============================================================================
# PixelCompute Town (像素算力鎮) v1.0 — Environment Configuration
# Copy this file to `.env` for local production testing or set in Render / Fly.io
# ==============================================================================

# Server listen port (default: 3456)
PORT=3456

# Bind host (use 0.0.0.0 for Docker / Render / Fly.io; 127.0.0.1 for local-only)
HOST=0.0.0.0

# Public base URL of your deployed instance (no trailing slash)
# Example: https://pixel-compute-town.onrender.com or https://town.yourdomain.com
APP_BASE_URL=http://localhost:3456

# Optional custom directory for persistent state JSON (default: ./data)
# Useful when mounting a persistent disk/volume at /app/data in production
PIXEL_DATA_DIR=./data

# Optional write API rate limit per IP per minute (default: 120)
RATE_LIMIT_MAX=120

# Optional secret used to sign session cookies in production (recommended: 32+ random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------------------------
# OAuth Providers (Optional — Email/Password & Demo Mode work out-of-the-box!)
# ------------------------------------------------------------------------------
# GitHub OAuth App: https://github.com/settings/developers -> OAuth Apps
# Callback URL: ${APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Track 1 Payments: Stablecoin Treasury Addresses (USDC / USDT)
# Supported EVM chains: Base (recommended), Polygon, Arbitrum
# Supported Solana: SPL USDC / USDT
# Leave empty to use built-in Sandbox/Demo treasury addresses for testing
# ------------------------------------------------------------------------------
TREASURY_EVM_ADDRESS=
TREASURY_SOL_ADDRESS=

# ------------------------------------------------------------------------------
# Track 2 Payments: Fiat Checkout & Webhooks (Polar.sh / Stripe)
# Leave empty to run built-in Sandbox Checkout for local & preview testing
# ------------------------------------------------------------------------------
# Polar.sh: https://polar.sh/dashboard -> Products / Webhooks
POLAR_CHECKOUT_URL=
POLAR_WEBHOOK_SECRET=

# Stripe: https://dashboard.stripe.com/apikeys -> Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
